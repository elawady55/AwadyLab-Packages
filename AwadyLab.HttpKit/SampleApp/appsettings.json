{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AwadyLab.HttpKit": "Debug"
    }
  },
  "AllowedHosts": "*",

  "HttpKit": {
    "Clients": {
      "Stripe": {
        "BaseUrl": { "Address": "https://api.stripe.com/" },
        "Resilience": {
          "Retry": { "MaxRetryAttempts": 2, "Delay": "00:00:00.250", "HonorRetryAfter": true },
          "Timeout": { "Attempt": "00:00:10", "Total": "00:00:30" },
          "CircuitBreaker": { "Enabled": true, "FailureRatio": 0.5, "BreakDuration": "00:00:30" }
        },
        "Limits": { "MaxResponseBytes": 2097152 },
        "Logging": { "LogBodies": false }
      },
      "Users": {
        "BaseUrl": { "Address": "https://users.example.test/" },
        "Caching": { "Enabled": true, "DefaultTtl": "00:01:00" }
      }
    }
  }
}
