{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Vault": {
    "VaultAddress": "http://localhost:8200",
    "RoleId": "",
    "SecretId": "",
    "SecretPath": "secret/data/certificates",
    "PkiPath": "pki",
    "TokenRenewalThresholdSeconds": 300,
    "CertificateRenewalThresholdSeconds": 86400
  },

  "Docker": {
    "SocketPath": "unix:///var/run/docker.sock",
    "LabelPrefix": "traefik.http.routers",
    "MonitoringIntervalSeconds": 30,
    "AllowInsecureSocket": false
  },

  "Certificate": {
    "OutputDirectory": "/certs",
    "TTL": "720h"
  },

  "ApiSecrets": {
    "_comment": "ApiKey decrypts eagerly with the 'Default' key; VaultToken only decrypts once the host is built, via UseKeyProvider.",
    "ApiKey": "X7P3ZG3uUBWO6yHTEE2cylkOeB2+hUKPgfiv3ZYMdzQxLf5aEOK6+eSy6XOQ6mZxTL8WiQ==",
    "VaultToken": "82ewa7nWzE4VuE0uQSONYdTT52+7r7F1VsU3qML7hO+yVUA65sqrjfYe7SfiOTDDhuU="
  },

  "Notifications": {
    "Channel": {
      "Type": "Slack",
      "WebhookUrl": "https://hooks.slack.example/services/T000/B000/XXX",
      "ChannelName": "#alerts"
    }
  },

  "Database": {
    "ConnectionStringName": "Default",
    "MaxPoolSize": 100,
    "CommandTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "_comment": "Password is encrypted with the 'Vault' key, decrypted on demand via GetConnectionStringWithEncryptPassword.",
    "Default": "Server=localhost;Database=SampleApp;User Id=sa;Password=srKIkkXUg7khIumXGVU6O9YaMs0n5njqLdFpAzxPckWonxuUC4/O4yUVwT8=;"
  },

  "License": {
    "LicensedTo": "Acme Corp",
    "MaxSeats": 25,
    "ExpiresOn": "2027-01-01"
  }
}
